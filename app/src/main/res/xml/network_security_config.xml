<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Only HTTPS traffic is allowed to the Samaj web app.
        Cleartext HTTP is disabled globally.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">web.suryavanshisamaj.online</domain>
        <domain includeSubdomains="true">suryavanshisamaj.online</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
