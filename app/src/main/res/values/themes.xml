<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main app theme — no action bar. Edge-to-edge is enabled in code;
         status/nav bar colours are drawn as Compose scrims. Those window-level
         colour attributes are deprecated on API 35+ and are intentionally omitted. -->
    <style name="Theme.SamajApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- Splash screen theme — white background, centered logo.
         Icon uses splash_icon (inset app_logo) so Android's splash screen
         safe-zone mask never clips the visible logo. The icon-background
         item is intentionally omitted to get the larger 192dp safe zone. -->
    <style name="Theme.SamajApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.SamajApp</item>
        <item name="android:windowBackground">@drawable/splash_fullscreen</item>
    </style>

</resources>
